# Local run: copy to .env, then `npm run dev`. On Clever Cloud, set the same
# names with `clever env set` (POSTGRESQL_ADDON_URI is injected by the add-on).
PORT=8522
POSTGRESQL_ADDON_URI=postgresql://bakery@127.0.0.1:8520/bakery

# Metabase add-on: the "Access it" URL printed by `clever addon create metabase`
METABASE_SITE_URL=https://your-metabase.services.clever-cloud.com
# Admin account created by the setup script on a fresh Metabase (first-run wizard).
# Random, 16+ characters: openssl rand -hex 24
METABASE_ADMIN_PASSWORD=
# Static embedding secret, its own random value, 64 hex characters: openssl rand -hex 32
METABASE_EMBEDDING_SECRET_KEY=
# Optional: admin e-mail (default baker@les-trois-fournils.example)
# METABASE_ADMIN_EMAIL=
